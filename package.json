{
	"name": "shades",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "jest",
		"test:unit:watch": "jest --watch",
		"test:unit:coverage": "jest --coverage",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"drizzle:generate": "drizzle-kit generate - out ./drizzle/migrations - breakpoints - schema=./src/lib/server/*",
		"drizzle:migrate": "tsx drizzle/migrate",
		"drizzle:studio": "drizzle-kit studio",
		"knip": "svelte-kit sync && knip"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@jest/globals": "^30.5.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bezier-js": "^4.1.3",
		"@types/d3-delaunay": "^6.0.4",
		"@types/jest": "^30.0.0",
		"@types/three": "^0.186.0",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.8",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"jest": "^30.1.3",
		"knip": "^6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"ts-jest": "^29.4.6",
		"tsx": "^4.21.0",
		"typescript": "^6",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.3.4"
	},
	"type": "module",
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@threlte/core": "^8.3.1",
		"@threlte/extras": "^9.7.1",
		"bezier-js": "^6.1.4",
		"d3-delaunay": "^6.0.4",
		"d3-geo-voronoi": "^2.1.0",
		"drizzle-orm": "^0.45.1",
		"paper": "^0.12.18",
		"svelte-drag-and-drop-actions": "^1.0.0",
		"svelte-icons-pack": "^3.1.3",
		"svg-path-outline": "^1.0.1",
		"three": "^0.186.1",
		"three-mesh-bvh": "^0.9.8",
		"uuid": "^14.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
